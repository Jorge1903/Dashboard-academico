{
  "name": "evaluacion/observatorio-academico",
  "description": "Dashboard academico embebido con JWT",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.17"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "allow-plugins": false
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  }
}